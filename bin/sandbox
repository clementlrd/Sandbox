#!/usr/bin/env python3
"""User-facing sandbox command. Dependencies: Python >= 3.11, Docker, Git."""
from pathlib import Path
import sys
import os

if os.environ.get('SANDBOX_PYTHON_LIB'):
    path = Path(os.environ['SANDBOX_PYTHON_LIB'])
else:
    root = Path(__file__).resolve().parent.parent
    path = root / 'libexec'
    if not (path / 'sandboxlib').is_dir():
        path = root / 'libexec' / 'sandbox'
sys.path.insert(0, str(path))
from sandboxlib.cli import main
raise SystemExit(main())
